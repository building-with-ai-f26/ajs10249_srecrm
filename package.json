{
  "name": "srecrm",
  "version": "0.1.0",
  "private": true,
  "description": "Sponsorship CRM for the NYU Stern Real Estate Club board",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dedupe": "node --env-file=.env scripts/dedupe-contacts.js",
    "survey": "node --env-file=.env scripts/survey-folder.js",
    "survey:headers": "node --env-file=.env scripts/survey-headers.js",
    "enrich:dry": "node --env-file=.env scripts/enrich-conferences.js"
  },
  "dependencies": {
    "@googleapis/drive": "^27.1.0",
    "@googleapis/sheets": "^18.1.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
